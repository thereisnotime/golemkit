{
  "name": "golemkit",
  "version": "0.1.0",
  "private": true,
  "description": "Framework for Minecraft bots (assistants, NPCs, LLM agents) on NeoForge servers, built on Mineflayer",
  "type": "module",
  "main": "src/cli.ts",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts run buddy",
    "bot": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc -p .",
    "test": "node --test test/"
  },
  "license": "LGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-nbt": "^2.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "mermaid": "^11.17.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
