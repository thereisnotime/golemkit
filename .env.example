# Copy to .env and adjust. Everything has a default; .env is optional.
MC_HOST=mc.example.com
MC_PORT=25565
MC_USERNAME=McBuddy
# offline (offline-mode servers like mc02) or microsoft (real account, device-code login, cached in .auth/)
MC_AUTH=offline
MC_VERSION=1.21.1
# Comma-separated players allowed to command the bot. Empty = everyone.
MC_OWNERS=
MC_PREFIX=!
# Let the bot break blocks (pathfinding through walls, !collect). Off by default.
MC_CAN_DIG=false
MC_RECONNECT_DELAY_MS=10000


# --- logging (see docs/guide/logging.md) ---
# Level spec: default level plus per-logger overrides, most specific wins.
#   e.g. info,McBuddy=debug,*/neoforge=trace,*/chat=warn
MC_LOG_LEVEL=info
# pretty (coloured) | plain | json
MC_LOG_FORMAT=pretty
# auto | always | never
MC_LOG_COLOR=auto
# time | iso | none
MC_LOG_TIME=time
# Combined log file and/or a directory with one file per bot (empty = off)
MC_LOG_FILE=
MC_LOG_DIR=
# plain | json (format used inside log files)
MC_LOG_FILE_FORMAT=plain
MC_LOG_MAX_SIZE_MB=20
MC_LOG_MAX_FILES=5

# --- LLM brain (bots/companion.ts, see docs/guide/llm-brain.md) ---
# claude-subscription | codex | anthropic | opencode | openai
MC_LLM_PROVIDER=claude-subscription
# Model for the provider (empty = provider default). anthropic defaults to claude-opus-5-5,
# claude-subscription takes aliases (sonnet, opus, haiku), codex/opencode their own ids.
MC_LLM_MODEL=
# Reasoning effort: low | medium | high (anthropic, claude-subscription; codex reasoning effort)
MC_LLM_EFFORT=
# Persona override and extra names the bot answers to (comma-separated)
MC_LLM_PERSONA=
MC_LLM_ALIASES=
# Autonomous check-in every N ms while idle (0 = only when spoken to)
MC_LLM_TICK_MS=0
# Greet players who join (costs a turn per join)
MC_LLM_GREET=false
# Guardrails. Hourly window is in memory, daily totals persist in data/bots/<name>/store.json.
# USD limits count real API spend only (anthropic, paid openai-compatible endpoints).
MC_LLM_TURNS_PER_HOUR=40
MC_LLM_TOKENS_PER_HOUR=400000
MC_LLM_USD_PER_HOUR=1
MC_LLM_TOKENS_PER_DAY=0
MC_LLM_USD_PER_DAY=5
MC_LLM_MAX_TOOL_CALLS=10
MC_LLM_TIMEOUT_MS=120000
# Price overrides for cost estimates, USD per million tokens:
#   {"model-id":[input, output, cacheRead, cacheWrite]}
MC_LLM_PRICES=
# MCP bridge (127.0.0.1 only, bearer token). 0 = random free port. EXPOSE=true also starts it
# for API providers and logs URL + token so you can drive the bot from your own agent CLI.
MC_LLM_MCP_PORT=0
MC_LLM_MCP_EXPOSE=false

# anthropic: API key from console.anthropic.com (billed per token)
ANTHROPIC_API_KEY=
# claude-subscription: uses your `claude` login (Pro/Max). For unattended bots, a long-lived
# token from `claude setup-token`. API keys above are NOT used unless this is true.
CLAUDE_CODE_OAUTH_TOKEN=
MC_CLAUDE_ALLOW_API_KEY=false
# sdk = Claude Agent SDK (default), cli = spawn `claude -p`
MC_CLAUDE_MODE=sdk
# sdk mode only: sdk = in-process MCP server (default), http = the bridge
MC_CLAUDE_TRANSPORT=sdk
MC_CLAUDE_BIN=
# codex: uses your `codex login` (ChatGPT). ~/.codex/config.toml is ignored unless true.
MC_CODEX_BIN=
MC_CODEX_USE_USER_CONFIG=false
# extra space-separated -c overrides, e.g. model_reasoning_effort="medium"
MC_CODEX_CONFIG=
# opencode (untested): uses `opencode auth login` providers; v2 | v1 config schema
MC_OPENCODE_BIN=
MC_OPENCODE_CONFIG_VERSION=v2
# openai-compatible: Ollama default; OpenRouter: https://openrouter.ai/api/v1
MC_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MC_OPENAI_API_KEY=

# --- LLM login profiles (see docs/guide/llm-brain.md) ---
# CLI providers run with their own HOME holding only their login; your ~/.claude, ~/.codex and
# shell variables are never used. Default .auth/<provider>; "user" = your normal login.
# Log in with: just llm-login claude | codex | opencode
MC_CLAUDE_PROFILE=
MC_CODEX_PROFILE=
MC_OPENCODE_PROFILE=
